<?php

/**
 * @file
 * Contains install, update and uninstall hooks.
 */

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\StringTranslation\TranslatableMarkup;

/**
 * Increase the max length of the entity label to 255 characters.
 */
function ewp_ounits_update_8101() {
  $field_spec = [
    'type' => 'varchar',
    'length' => '255',
    'not null' => TRUE,
  ];
  \Drupal::database()->schema()->changeField('ounit', 'label', 'label', $field_spec);

  $definition = BaseFieldDefinition::create('string')
    ->setLabel(new TranslatableMarkup('Label'))
    ->setDescription(new TranslatableMarkup('The internal label of the Organizational Unit entity.'))
    ->setSettings([
      'max_length' => 255,
      'text_processing' => 0,
    ])
    ->setDefaultValue('')
    ->setDisplayOptions('view', [
      'label' => 'hidden',
      'type' => 'string',
      'weight' => -20,
    ])
    ->setDisplayOptions('form', [
      'type' => 'string_textfield',
      'weight' => -20,
    ])
    ->setDisplayConfigurable('form', TRUE)
    ->setDisplayConfigurable('view', TRUE)
    ->setRequired(TRUE);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('label', 'ounit', 'ounit', $definition);
}

/**
 * Adds the 'uid' field for ounits to have owners.
 */
function ewp_ounits_update_10602() {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $storage_definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('ounit');

  if (isset($storage_definitions['uid'])) {
    // Install the field definition as it exists in the new Ounit class.
    // Provide an initial value of 0 (Anonymous) to satisfy 'NOT NULL'.
    $update_manager->installFieldStorageDefinition('uid', 'ounit', 'ewp_ounits', $storage_definitions['uid']);

    // Explicitly update any NULLs to 0 just in case.
    \Drupal::database()->update('ounit')
      ->fields(['uid' => 0])
      ->condition('uid', NULL, 'IS NULL')
      ->execute();
  }

  \Drupal::logger('ewp_ounits')->notice(t('Added uid field and default value to ounit table successfully'));
}

/**
 * Convert 'ounit' entity to revisionable and apply all annotation updates.
 */
function ewp_ounits_update_10603(&$sandbox) {
  $update_manager = \Drupal::entityDefinitionUpdateManager();

  // Retrieve and prepare the current entity type definition.
  $entity_type = $update_manager->getEntityType('ounit');

  // Apply the new revisionable and owner configurations.
  $entity_type->set('revision_table', 'ounit_revision');
  $entity_type->set('revisionable', TRUE);
  $entity_type->set('show_revision_ui', TRUE);

  $entity_type->set('entity_keys', [
    'id' => 'id',
    'revision' => 'revision_id',
    'label' => 'label',
    'uuid' => 'uuid',
    'langcode' => 'langcode',
    'published' => 'status',
    'owner' => 'uid',
    'revision_default' => 'revision_default',
  ]);

  $entity_type->set('revision_metadata_keys', [
    'revision_user' => 'revision_uid',
    'revision_created' => 'revision_timestamp',
    'revision_log_message' => 'revision_log',
    'revision_default' => 'revision_default',
  ]);

  // Fetch storage definitions directly from your new Ounit class.
  $field_storage_definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('ounit');

  // This tells Drupal to use '0' (Anonymous) for all existing rows.
  if (isset($field_storage_definitions['uid'])) {
    $field_storage_definitions['uid']->setInitialValue(0);
    $field_storage_definitions['uid']->setRevisionable(TRUE);
  }

  // Mark other core fields as revisionable to ensure moving to the new table.
  $revisionable_fields = ['label', 'status', 'changed'];
  foreach ($revisionable_fields as $field_name) {
    if (isset($field_storage_definitions[$field_name])) {
      $field_storage_definitions[$field_name]->setRevisionable(TRUE);
    }
  }

  // Run the Schema Conversion.
  $update_manager->updateFieldableEntityType($entity_type, $field_storage_definitions, $sandbox);

  \Drupal::logger('ewp_ounits')->notice(t('Schema conversion to revisionable ran successfully'));

  $database = \Drupal::database();

  // Copy the 'changed' time from the base table into the revision table.
  $database->query("
    UPDATE {ounit_revision} r
    INNER JOIN {ounit} b ON r.id = b.id
    SET r.revision_timestamp = b.changed
    WHERE r.revision_timestamp IS NULL OR r.revision_timestamp = 0
  ");

  // Ensure the revision_uid is set to something valid.
  $database->query("
    UPDATE {ounit_revision} r
    INNER JOIN {ounit} b ON r.id = b.id
    SET r.revision_uid = b.uid
    WHERE r.revision_uid IS NULL
  ");

  \Drupal::logger('ewp_ounits')->notice(t('Ounit revision metadata (timestamps and UIDs) has been synchronized.'));

  // Deleting backup tables created by Drupal.
  _ewp_cleanup_backup_tables('ounit');

  \Drupal::logger('ewp_ounits')->notice(t('Backup tables removed after successful conversion.'));
}

/**
 * Clean up backup tables created by the ounit schema conversion.
 */
function _ewp_cleanup_backup_tables(string $entity_type_id) {
  $schema = \Drupal::database()->schema();

  // Find all tables that look like backups for this entity type.
  // The pattern matches "old_" + 6 random chars + our table name.
  $tables = $schema->findTables('old_______' . $entity_type_id . '%');

  foreach ($tables as $table) {
    if ($schema->tableExists($table)) {
      $schema->dropTable($table);
    }
  }
}
